 func TestParseChannelListError(t *testing.T) {
-	if _, err := parseChannelList("1 bogus 3 [0]"); err == nil {
+	// A bogus token in the MIDDLE is a genuine parse error, not truncation.
+	if _, _, err := parseChannelList("1 bogus 3 [0]"); err == nil {
 		t.Fatal("expected error for an unparseable token")
 	}
 }
+
+// On busy looks Eos truncates the /eos/out/active/chan display string at a fixed
+// width, cutting the final token mid-range and marking it with an ellipsis (e.g.
+// "…,80-85,10.."). The parser must salvage the complete channels rather than
+// hard-erroring on the fragment — otherwise read_stage returns nothing on exactly
+// the crowded looks an operator most wants to inspect. This is the exact string
+// captured from the field (cue 6.1), which is 100 chars — Eos's cut length.
+func TestParseChannelListTruncated(t *testing.T) {
+	const s = "2,7-8,10-11,14-15,17-18,21-22,24-25,28-29,31-32,35-36,38-39,42-43,45-46,56-57,59-60,76-78,80-85,10.."
+	got, truncated, err := parseChannelList(s)
+	if err != nil {
+		t.Fatalf("truncated active-channel string should parse leniently, got error: %v", err)
+	}
+	if !truncated {
+		t.Fatal("expected truncated=true so read_stage can flag the look partial")
+	}
+	// Every channel before the "10.." fragment must survive: 2, 7-8, 10-11, ...,
+	// 76-78, 80-85 — 38 channels, none above 85 (the fragment is dropped, not
+	// mis-parsed into a phantom channel 10).
+	if len(got) != 38 {
+		t.Fatalf("got %d channels %v, want 38", len(got), got)
+	}
+	if got[0] != 2 || got[len(got)-1] != 85 {
+		t.Fatalf("got range %d..%d, want 2..85", got[0], got[len(got)-1])
+	}
+}
+
+// A dangling range with no ellipsis (hard cut mid-token, e.g. "…,80-85,101-") is
+// truncation too — the final token is salvaged as partial, not an error.
+func TestParseChannelListTruncatedDanglingRange(t *testing.T) {
+	got, truncated, err := parseChannelList("1-3,7,101-")
+	if err != nil {
+		t.Fatalf("dangling final range should parse leniently, got error: %v", err)
+	}
+	if !truncated {
+		t.Fatal("expected truncated=true for a dangling final range")
+	}
+	if !reflect.DeepEqual(got, []int{1, 2, 3, 7}) {
+		t.Fatalf("got %v, want [1 2 3 7]", got)
+	}
+}
