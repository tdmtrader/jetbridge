+        -- constructor so it carries the harvest row's own outcome/color (a
+        -- failed harvest reads as one red/amber box).
+        [ agentStepBox buildId rm ]
+
+    else
+        expanded
 
 
 gateBox : Int -> Agent.GateResult -> StepBox
