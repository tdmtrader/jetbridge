{
  "dialect": "record-schema-dialect/1",
  "contract": "pull-request/v1",
  "envelope": "record/v1",
  "revision": 2,
  "supersedes": 1,
  "description": "Platform-authored normalized provider observation and actionable pull-request trigger.",
  "subject_shape": {
    "minimum": 0,
    "maximum": null,
    "roles": {
      "primary": { "minimum": 0, "maximum": null },
      "base": { "minimum": 0, "maximum": null },
      "evidence": { "minimum": 0, "maximum": null },
      "context": { "minimum": 0, "maximum": null },
      "candidate": { "minimum": 0, "maximum": null },
      "reference": { "minimum": 0, "maximum": null }
    },
    "subject_type": null,
    "uniform_subject_type": false,
    "ports": "any-exposed-input"
  },
  "fields": {
    "body": { "kind": "object", "presence": "required" },
    "body/provider": { "kind": "string", "presence": "required" },
    "body/repository": { "kind": "string", "presence": "required" },
    "body/external_id": { "kind": "identifier", "presence": "optional" },
    "body/url": { "kind": "string", "presence": "optional" },
    "body/state": { "kind": "enum", "presence": "required", "values": [{ "value": "active" }, { "value": "missing" }, { "value": "completed" }, { "value": "abandoned" }] },
    "body/mergeability": { "kind": "enum", "presence": "required", "values": [{ "value": "mergeable" }, { "value": "conflicted" }, { "value": "policy_blocked" }, { "value": "unknown" }] },
    "body/source_ref": { "kind": "string", "presence": "required" },
    "body/source_sha": { "kind": "string", "presence": "optional" },
    "body/expected_source": { "kind": "object", "presence": "optional" },
    "body/expected_source/exists": { "kind": "bool", "presence": "optional", "absent_image": "zero" },
    "body/expected_source/sha": { "kind": "string", "presence": "optional" },
    "body/target_ref": { "kind": "string", "presence": "required" },
    "body/target_sha": { "kind": "string", "presence": "required" },
    "body/iteration": { "kind": "identifier", "presence": "required" },
    "body/trigger": { "kind": "enum", "presence": "required", "values": [{ "value": "initial_publish" }, { "value": "review_batch" }, { "value": "conflict" }, { "value": "freshness" }, { "value": "completed" }, { "value": "abandoned" }] },
    "body/review_batches": { "kind": "entity-set", "presence": "optional", "id_field": "id" },
    "body/review_batches/*/id": { "kind": "identifier", "presence": "required" },
    "body/review_batches/*/review_id": { "kind": "identifier", "presence": "required" },
    "body/review_batches/*/commit_sha": { "kind": "string", "presence": "required" },
    "body/review_batches/*/reviewer": { "kind": "identifier", "presence": "required" },
    "body/review_batches/*/ready": { "kind": "bool", "presence": "required", "absent_image": "zero" },
    "body/review_batches/*/thread_ids": { "kind": "array", "presence": "optional", "element": "identifier", "unique": true, "sorted": true },
    "body/threads": { "kind": "entity-set", "presence": "optional", "id_field": "id" },
    "body/threads/*/id": { "kind": "identifier", "presence": "required" },
    "body/threads/*/iteration": { "kind": "identifier", "presence": "required" },
    "body/threads/*/anchor": { "kind": "object", "presence": "optional" },
    "body/threads/*/anchor/path": { "kind": "string", "presence": "required" },
    "body/threads/*/anchor/start_line": { "kind": "int", "presence": "required", "absent_image": "zero", "minimum": 1 },
    "body/threads/*/anchor/end_line": { "kind": "int", "presence": "required", "absent_image": "zero", "minimum": 1 },
    "body/threads/*/comments": { "kind": "entity-set", "presence": "optional", "id_field": "id" },
    "body/threads/*/comments/*/id": { "kind": "identifier", "presence": "required" },
    "body/threads/*/comments/*/author": { "kind": "identifier", "presence": "required" },
    "body/threads/*/comments/*/body": { "kind": "markdown", "presence": "required" },
    "body/threads/*/comments/*/commit_sha": { "kind": "string", "presence": "required" }
  },
  "go_only_rules": [
    { "id": "observation-state-shape", "rule": "Missing observations require an explicit expected source and omit provider PR identity; observed active and terminal states require exact external identity and heads and forbid an expected source." },
    { "id": "expected-head-shape", "rule": "An absent expected source has an empty SHA, while an existing expected source has a full object ID." },
    { "id": "trigger-state-pairing", "rule": "initial_publish is valid only for missing observations; all other trigger tokens require their matching observed lifecycle." },
    { "id": "stable-provider-identities", "rule": "Object IDs, refs, provider iteration, batch/review/thread/comment identities, reviewer readiness, bounded markdown, anchors, and batch thread references are semantically validated and canonically ordered." },
    { "id": "bounded-provider-observation", "rule": "Provider is at most 64 bytes; repository 512; URL 2048; refs 512; identifiers and iteration 256; paths 1024; review batches 128; threads 512; comments per thread 256; and batch thread IDs 512." }
  ]
}
