#!/usr/bin/env python3
"""Explicit smoke consuming subscription usage; behavioral assertions live in Brine."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import uuid


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--auth-file", required=True, type=Path)
    parser.add_argument("--model", required=True)
    parser.add_argument("--brine-image", required=True,
                        help="Linux image containing brine, sh and CA certificates")
    parser.add_argument("--binaries", required=True, type=Path,
                        help="directory containing host jb, Linux jb-review-worker, pinned codex and codex-code-mode-host")
    parser.add_argument("--adapter", required=True, type=Path, help="Linux Brine adapter")
    parser.add_argument("--output", required=True, type=Path, help="new evidence directory")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    suite = root / "atc/worker/jetbridge/brine"
    binaries, adapter = args.binaries.resolve(), args.adapter.resolve()
    for executable in [binaries / "jb", binaries / "jb-review-worker", binaries / "codex",
                       binaries / "codex-code-mode-host", adapter]:
        if not executable.is_file():
            parser.error(f"missing executable: {executable}")
    output = args.output.resolve()
    output.mkdir(mode=0o700)  # Refuse to overwrite previous evidence.
    repo = output / "private-fixture"
    repo.mkdir()
    git_env = dict(os.environ, GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL="/dev/null")

    def git(*arguments):
        return subprocess.check_output(["git", "-C", str(repo), *arguments],
                                       env=git_env, stderr=subprocess.DEVNULL).decode().strip()

    git("init", "-q")
    git("config", "user.name", "Review acceptance")
    git("config", "user.email", "review@example.invalid")
    source = repo / "parser.go"
    source.write_text("package parser\nfunc First(s string) byte { return s[0] }\n")
    git("add", "parser.go")
    git("commit", "-qm", "base")
    base = git("rev-parse", "HEAD")
    source.write_text("package parser\nfunc First(s string) byte { return s[1] }\n")
    git("commit", "-qam", "change")
    plan = output / "plan.md"
    plan.write_text("Return the first byte of a nonempty string. Preserve that behavior.\n")
    subprocess.run([str(binaries / "jb"), "review", "capture", "--repo", str(repo),
                    "--base", base, "--plan", str(plan), "--output", str(output / "input")],
                   check=True, stdout=subprocess.DEVNULL)
    reports = output / "output"
    reports.mkdir(mode=0o700)
    name = "jb-review-subscription-" + uuid.uuid4().hex[:12]
    command = ["docker", "run", "--rm", "-i", "--name", name, "--read-only",
               "--tmpfs", "/tmp:rw,nosuid,nodev,size=256m,mode=1777",
               "--tmpfs", "/dev/shm:rw,nosuid,nodev,size=128m,mode=1777",
               "--mount", f"type=bind,src={suite},dst=/suite,readonly",
               "--mount", f"type=bind,src={adapter},dst=/suite/.build/brine-adapter-jetbridge,readonly",
               "--mount", f"type=bind,src={binaries},dst=/live/bin,readonly",
               "--mount", f"type=bind,src={output / 'input'},dst=/live/input,readonly",
               "--mount", f"type=bind,src={reports},dst=/live/output",
               "--env", "BRINE_REVIEW_LIVE_ROOT=/live",
               "--env", f"BRINE_REVIEW_LIVE_MODEL={args.model}", "--workdir", "/suite",
               "--entrypoint", "/bin/sh", args.brine_image, "-ec",
               "umask 077; mkdir /dev/shm/review-live-auth; "
               "cat > /dev/shm/review-live-auth/auth.json; umask 022; "
               "exec brine run features/subscription/review-live.feature --mode sync --format brief"]
    # Never pass credentials as an argument, environment value, mount or artifact.
    auth = args.auth_file.read_bytes()
    try:
        run = subprocess.run(command, input=auth, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, timeout=360)
    finally:
        subprocess.run(["docker", "rm", "-f", name], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=30)
        remaining = subprocess.check_output(
            ["docker", "ps", "-aq", "--filter", f"name=^/{name}$"], timeout=30)
        if remaining.strip():
            raise SystemExit("Disposable credential container cleanup failed")
    if args.auth_file.read_bytes() != auth:
        raise SystemExit("Original auth file changed during acceptance")

    def strings(value):
        if isinstance(value, dict):
            return [s for v in value.values() for s in strings(v)]
        return [value.encode()] if isinstance(value, str) and len(value) >= 12 else []

    secrets = strings(json.loads(auth))
    persisted = [p for p in reports.rglob("*") if p.is_file()]
    if any(secret in data for secret in secrets
           for data in [run.stdout, *(p.read_bytes() for p in persisted)]):
        shutil.rmtree(reports)
        raise SystemExit("Credential-bearing output suppressed and removed")
    (output / "brine.log").write_bytes(run.stdout)
    print(run.stdout.decode(errors="replace"), end="")
    print("Original auth unchanged; disposable credential container removed.")
    raise SystemExit(run.returncode)


if __name__ == "__main__":
    main()
