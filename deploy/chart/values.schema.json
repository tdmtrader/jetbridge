        },
        "runCredentialWorkerImages": {
          "$ref": "#/definitions/strings"
        },
        "runResults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scratchSizeLimit": {
              "$ref": "#/definitions/quantity"
            },
            "readConcurrency": {
              "type": "integer"
            }
          }
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/openList"
        },
        "extraVolumes": {
          "$ref": "#/definitions/openList"
        },
        "livenessProbe": {
          "$ref": "#/definitions/openMap"
        },
        "readinessProbe": {
          "$ref": "#/definitions/openMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/openMap"
        },
        "tolerations": {
          "$ref": "#/definitions/openList"
        },
        "affinity": {
          "$ref": "#/definitions/openMap"
        }
      }
    },
