        },
        "terminationGracePeriodSeconds": {
          "type": "integer"
        },
        "resources": {
          "$ref": "#/definitions/openMap"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "bindPort": {
              "$ref": "#/definitions/port"
