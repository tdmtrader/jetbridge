{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "artifactDaemon": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "existingSecret",
                "generated"
              ]
            }
          }
        },
        "hangar": {
          "type": "object",
          "properties": {
            "store": {
              "type": "string",
              "enum": [
                "",
                "gcs",
                "disk"
              ]
            },
            "bucket": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clients",
        "disabledOperations"
      ],
      "properties": {
        "clients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "client_id",
              "client_name",
              "redirect_uris"
            ],
            "properties": {
              "client_id": {
                "type": "string",
                "minLength": 1
              },
              "client_name": {
                "type": "string",
                "minLength": 1
              },
              "redirect_uris": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^https?://[^*]+$"
                }
              }
            }
          }
        },
        "disabledOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hangarOutput": {
      "type": "object",
      "properties": {
        "store": {
          "type": "string",
          "enum": [
            "gcs",
            "disk"
          ]
        }
      }
    },
    "hangarStorage": {
      "type": "object",
      "properties": {
        "disk": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "initialize": {
              "type": "boolean"
            },
            "storeID": {
              "type": "string"
            },
            "accessMode": {
              "type": "string",
              "enum": [
                "ReadWriteOnce",
                "ReadWriteOncePod"
              ]
            },
            "maxObjectBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxConcurrent": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
