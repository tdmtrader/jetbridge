{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "Closed: every object refuses a key it does not list, except the free-form Kubernetes maps and lists on openMaps and the inside of the groups on deferredGroups (deploy/chart/tests/shape_test.go). A new value needs an entry here, and the guards in shape_test.go decide whether it may have one.",
  "definitions": {
    "port": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "string",
          "pattern": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})$"
        }
      ]
    },
    "optionalPort": {
      "anyOf": [
        {
          "$ref": "#/definitions/port"
        },
        {
          "type": "string",
          "enum": [
            ""
          ]
        }
      ]
    },
    "goDuration": {
      "type": "string",
      "pattern": "^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
    },
    "optionalGoDuration": {
      "type": "string",
      "pattern": "^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)?$"
    },
    "prometheusDuration": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$"
    },
    "quantity": {
      "type": [
        "string",
        "integer"
      ]
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openMap": {
      "type": "object"
    },
    "openList": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "removed": {
      "description": "Removed. The schema still accepts it for one release so the render fails in templates/_validate.tpl with a message naming the replacement."
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "description": "A string; --set parses an all-digit tag as an integer.",
          "type": [
            "string",
            "integer"
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "$ref": "#/definitions/strings"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer"
        },
        "strategy": {
          "$ref": "#/definitions/openMap"
        },
        "externalUrl": {
          "type": "string",
          "minLength": 1
        },
        "clusterName": {
          "type": "string"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "error",
            "fatal"
