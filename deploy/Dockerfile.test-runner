# Build environment for Concourse CI pipeline tasks.
#
# THIS FILE HAD DRIFTED. v6/v7/v8 were built by hand as the pipeline hit one
# missing tool after another -- PostgreSQL for the unit tier, helm for the
# chart tests, zip for the fly-download endpoint -- and none of those additions
# came back here. Anyone rebuilding from the old file would have produced an
# image that silently lost Postgres and failed `make test-unit`. Everything the
# running image contains is now declared below; keep it that way.

# --- brine ------------------------------------------------------------------
# The brine CLI is a Rust workspace in a PRIVATE third-party repository, so it
# cannot be fetched at task time and cannot be copied from a developer's Mac
# (that binary is Mach-O arm64; tasks run linux/amd64). It is built here and
# only the two binaries are carried forward, which keeps Rust, protoc and the
# ~5GB target dir out of the final image.
#
# The GitHub token is consumed in this stage ONLY, via a BuildKit secret mount
# (see below). Builder stages are discarded and never pushed, so it reaches no
# layer of the shipped image -- but the mount is what keeps it out of the build
# LOG, which is the part that actually went wrong the first time.
FROM rust:1.98-bookworm AS brine
# Required: resolve this full SHA from the private Brine replacement in
# atc/worker/jetbridge/brine/go.mod. A branch name can move independently of
# the adapter's contract; do not build the CLI/engine from a floating branch.
ARG BRINE_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends \
      protobuf-compiler ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
# Git's remote URL never contains the credential, including in failure logs.
# BuildKit mounts the secret for this RUN only; neither it nor the askpass
# script is copied to the final image. Only the final runner stage is pushed.
RUN --mount=type=secret,id=gh,required=true \
    test -n "${BRINE_COMMIT}" \
    && printf '%s\n' '#!/bin/sh' \
         'case "$1" in *Username*) echo x-access-token ;; *Password*) cat /run/secrets/gh ;; *) exit 1 ;; esac' \
         > /tmp/brine-askpass \
    && chmod 700 /tmp/brine-askpass \
    && git init /brine \
    && git -C /brine remote add origin https://github.com/MarkDucommun/brine-private.git \
    && GIT_ASKPASS=/tmp/brine-askpass GIT_TERMINAL_PROMPT=0 \
         git -C /brine fetch --depth 1 origin "${BRINE_COMMIT}" \
    && git -C /brine checkout --detach FETCH_HEAD \
    && test "$(git -C /brine rev-parse HEAD)" = "${BRINE_COMMIT}" \
    && git -C /brine rev-parse HEAD > /brine-commit \
    && rm /tmp/brine-askpass
WORKDIR /brine
# brine run spawns brine-engine as a separate process and looks it up on PATH;
# building only brine-cli yields engine_unreachable at the first scenario.
RUN cargo build --locked --release --jobs 4 -p brine-cli --bin brine \
    && cargo build --locked --release --jobs 4 -p brine-engine

# --- runner -----------------------------------------------------------------
FROM golang:1.25-bookworm AS runner

# Allow a checked-out task's Go module to select its required toolchain.
ENV GOTOOLCHAIN=auto

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl git jq zip unzip ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# PostgreSQL 17 server AND client: the unit and integration tiers need a real
# server, and postgresrunner spawns its own instances from these binaries.
# policy-rc.d stops dpkg trying to start the service during the image build.
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod +x /usr/sbin/policy-rc.d \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
         -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
         > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-17 postgresql-client-17 \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/lib/postgresql/17/bin:${PATH}"

# Pin the command-line client and envtest API server to the Kubernetes
# minor used by the root module. Verify downloads before installing them.
ARG KUBERNETES_VERSION=1.35.0
RUN curl -fsSL --retry 5 --retry-all-errors --retry-delay 3 \
      "https://dl.k8s.io/release/v${KUBERNETES_VERSION}/bin/linux/amd64/kubectl" \
      -o /tmp/kubectl \
    && echo 'a2e984a18a0c063279d692533031c1eff93a262afcc0afdc517375432d060989  /tmp/kubectl' | sha256sum -c - \
    && install -m 755 /tmp/kubectl /usr/local/bin/kubectl \
    && rm /tmp/kubectl

# Docker CLI for the build-image job, which mounts a DinD socket.
RUN curl -fsSL --retry 5 --retry-all-errors --retry-delay 3 https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz \
    | tar xz --strip-components=1 -C /usr/local/bin docker/docker

# Pinned: the chart tests render against a known helm, and a floating version
# has changed rendering under us before.
RUN curl -fsSL --retry 5 --retry-all-errors --retry-delay 3 https://get.helm.sh/helm-v3.16.4-linux-amd64.tar.gz \
    | tar xz --strip-components=1 -C /usr/local/bin linux-amd64/helm

COPY --from=brine /brine/target/release/brine        /usr/local/bin/brine
COPY --from=brine /brine/target/release/brine-engine /usr/local/bin/brine-engine
COPY --from=brine /brine-commit                      /etc/brine-commit

# brine-go is deliberately NOT shipped here. The adapter's go.mod now replaces it
# with a module path into the private repository, so the task fetches it at a
# pinned pseudo-version using GOPRIVATE and a credential. Baking a copy of
# someone else's private source into an image was the wrong shape: it duplicated
# the module, and pinned it to whenever this image happened to be built rather
# than to what the checkout asks for.
ENV GOPRIVATE=github.com/MarkDucommun/*

# envtest assets back the brine `real-cluster` resource; without them every
# scenario using it fails with "no envtest assets" before running anything.
ENV KUBEBUILDER_ASSETS=/opt/envtest/bin
RUN curl -fsSL --retry 5 --retry-all-errors --retry-delay 3 \
      "https://github.com/kubernetes-sigs/controller-tools/releases/download/envtest-v${KUBERNETES_VERSION}/envtest-v${KUBERNETES_VERSION}-linux-amd64.tar.gz" \
      -o /tmp/envtest.tar.gz \
    && echo '5716719def14a3fec3ed285e5e8c4280e6268854039b5073a96e8c0adafb1c02  /tmp/envtest.tar.gz' | sha256sum -c - \
    && mkdir -p /opt/envtest/bin \
    && tar xzf /tmp/envtest.tar.gz --strip-components=2 -C /opt/envtest/bin \
    && test -x /opt/envtest/bin/kube-apiserver \
    && test -x /opt/envtest/bin/etcd \
    && rm /tmp/envtest.tar.gz

# Tasks supply their own immutable repo input. Warm the public root module
# cache without copying a developer's checkout or private Brine source.
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
