type Canonicalizer struct { MaxEntries int64 MaxContentBytes int64 TempDir string }
type CapturedTree struct { Root string ArchivePath string Digest Digest ByteSize int64 FileCount int64 }
type Digest string
type Purpose string
type Scope string
type Signer struct { }
type TreeAttributes struct { Ref TreeRef StoredBytes int64 LogicalBytes int64 CreatedAt time.Time }
type TreeLimits struct { MaxContentBytes int64 MaxEntries int64 }
type TreeRef struct { Scope Scope Digest Digest Generation int64 }
type Verifier struct { }
type Warrant struct { Purpose Purpose Version int Ref TreeRef Handle string Volume string ClaimID string NodeUID string Operation string ExecutionID string Fence uint64 IssuedAt int64 ExpiresAt int64 Nonce string }
