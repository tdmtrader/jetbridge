{
  "name": "access-token-factory-strict",
  "test_package": "./atc/db",
  "source_test_file": "atc/db/access_token_factory_test.go",
  "feature": "atc/worker/jetbridge/brine/features/access-token-db-strict.feature",
  "step_files": [
    "atc/worker/jetbridge/brine/steps/access_token_db_strict.go",
    "atc/worker/jetbridge/brine/steps/registry.go",
    "atc/worker/jetbridge/brine/steps/resources.go",
    "atc/worker/jetbridge/brine/steps/task_command.go",
    "atc/worker/jetbridge/brine/steps/envtest.go",
    "atc/postgresrunner/postgresrunner.go",
    "atc/postgresrunner/ginkgo.go",
    "atc/postgresrunner/join_limit_conn.go"
  ],
  "cases": [
    {
      "id": "create-persists-claims",
      "source_file": "atc/db/access_token_factory.go",
      "old": "\t\tValues(token, claims.Subject, time.Unix(expiry, 0), claims).",
      "new": "\t\tValues(token, claims.Subject, time.Unix(expiry, 0), Claims{}).",
      "tests": ["Access Token Factory can create and fetch access tokens"],
      "scenarios": ["Production access-token database behavior — <profile> (row 1)"]
    },
    {
      "id": "delete-selects-requested-token",
      "source_file": "atc/db/access_token_factory.go",
      "old": "\t\tWhere(sq.Eq{\"token\": token}).\n\t\tRunWith(a.conn).\n\t\tExec()",
      "new": "\t\tWhere(sq.Eq{\"token\": \"never-issued\"}).\n\t\tRunWith(a.conn).\n\t\tExec()",
      "tests": ["Access Token Factory can delete access tokens"],
      "scenarios": ["Production access-token database behavior — <profile> (row 2)"]
    }
  ]
}
