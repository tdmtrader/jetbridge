      "id": "live-check-sessions-are-not-orphans",
      "source_file": "atc/db/container_repository.go",
      "old": "\t\t\tsq.Eq{\n\t\t\t\t\"c.build_id\":                         nil,\n\t\t\t\t\"c.resource_config_check_session_id\": nil,\n\t\t\t\t\"c.in_memory_build_id\":               nil,\n\t\t\t},",
      "new": "\t\t\tsq.And{\n\t\t\t\tsq.Eq{\"c.build_id\": nil, \"c.in_memory_build_id\": nil},\n\t\t\t\tsq.NotEq{\"c.resource_config_check_session_id\": nil},\n\t\t\t},",
      "tests": [
        "ContainerRepository FindOrphanedContainers check containers when check container best if use by date did not expire does not find the container for deletion",
        "ContainerRepository FindOrphanedContainers check containers when the same worker base resource type is saved does not find the container for deletion"
      ],
      "scenarios": [
        "Live container repository profile <profile> preserves <observation> (row 1)",
        "Live container repository profile <profile> preserves <observation> (row 2)"
      ]
    },
    {
      "id": "destroy-failed-reports-exact-affected-count",
      "source_file": "atc/db/container_repository.go",
      "old": "\taffected, err := result.RowsAffected()\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\treturn int(affected), nil\n}\n\nfunc (repository *containerRepository) DestroyUnknownContainers",
      "new": "\taffected, err := result.RowsAffected()\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\treturn int(affected) + 1, nil\n}\n\nfunc (repository *containerRepository) DestroyUnknownContainers",
      "tests": [
        "ContainerRepository DestroyFailedContainers when there are no failed containers returns an empty array"
      ],
      "scenarios": [
        "Live container repository profile <profile> preserves <observation> (row 3)"
      ]
    },
    {
      "id": "unknown-containers-enter-destroying-state",
      "source_file": "atc/db/container_repository.go",
      "old": "\t\tinsertBuilder = insertBuilder.Values(\n\t\t\tunknownHandle,\n\t\t\tworkerName,\n\t\t\tatc.ContainerStateDestroying,\n\t\t)",
      "new": "\t\tinsertBuilder = insertBuilder.Values(\n\t\t\tunknownHandle,\n\t\t\tworkerName,\n\t\t\tatc.ContainerStateCreated,\n\t\t)",
      "tests": [
        "ContainerRepository DestroyUnknownContainers when there are containers on the worker that are not in the db does not affect containers in any other state"
