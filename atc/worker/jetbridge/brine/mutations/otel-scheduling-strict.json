      "scenarios": ["OTel profile <profile> exports its production measurement (row 24)"]
    },
    {
      "id": "scheduling-duration-pipeline-attribute",
      "source_file": "atc/metric/otel_scheduling.go",
      "old": "\t\t\tattribute.String(\"pipeline\", pipeline),",
      "new": "\t\t\tattribute.String(\"pipeline.name\", pipeline),",
