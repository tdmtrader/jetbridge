{
  "name": "idtoken-manager-strict",
  "test_package": "./atc/creds/idtoken",
  "source_test_file": "atc/creds/idtoken/manager_test.go",
  "feature": "atc/worker/jetbridge/brine/features/idtoken-manager-strict.feature",
  "step_files": [
    "atc/worker/jetbridge/brine/steps/idtoken_manager_strict.go",
    "atc/worker/jetbridge/brine/steps/registry.go",
    "atc/worker/jetbridge/brine/steps/resources.go",
    "atc/worker/jetbridge/brine/steps/task_command.go",
    "atc/worker/jetbridge/brine/steps/envtest.go",
    "atc/postgresrunner/postgresrunner.go",
    "atc/postgresrunner/ginkgo.go",
    "atc/postgresrunner/join_limit_conn.go"
  ],
  "cases": [
    {
      "id": "issuer-is-preserved",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\t\t\tIssuer:            issuer,",
      "new": "\t\t\tIssuer:            issuer + \"-wrong\",",
      "tests": ["IDToken Manager accepts valid configuration"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 1)"]
    },
    {
      "id": "audience-must-be-a-list",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\t\t\tif audList, ok := value.([]any); ok {",
      "new": "\t\t\tif audList, ok := value.([]any); ok || value != nil {",
      "tests": ["IDToken Manager rejects malformed audience"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 2)"]
    },
    {
      "id": "subject-scope-must-be-a-string",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\t\t\tif subjectScopeString, ok := value.(string); ok {",
      "new": "\t\t\tif subjectScopeString, ok := value.(string); ok || value != nil {",
      "tests": ["IDToken Manager rejects malformed subject_scope"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 3)"]
    },
    {
      "id": "expires-in-must-parse",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\t\t\t\tif err != nil {",
      "new": "\t\t\t\tif false && err != nil {",
      "tests": ["IDToken Manager rejects malformed expires_in"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 4)"]
    },
    {
      "id": "algorithm-must-be-a-string",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\t\t\tif algorithmString, ok := value.(string); ok {",
      "new": "\t\t\tif algorithmString, ok := value.(string); ok || value != nil {",
      "tests": ["IDToken Manager rejects malformed algorithm"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 5)"]
    },
    {
      "id": "unknown-settings-are-rejected",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\t\tdefault:\n\t\t\treturn nil, fmt.Errorf(\"invalid idtoken provider config: unknown setting: %s\", key)",
      "new": "\t\tdefault:\n\t\t\tcontinue",
      "tests": ["IDToken Manager rejects unknown settings"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 6)"]
    },
    {
      "id": "unknown-subject-scope-is-rejected",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\tif !manager.tokenGenerator.SubjectScope.Valid() {",
      "new": "\tif false && !manager.tokenGenerator.SubjectScope.Valid() {",
      "tests": ["IDToken Manager rejects unknown subject_scope"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 7)"]
    },
    {
      "id": "expiration-is-capped-at-24-hours",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\tif manager.tokenGenerator.ExpiresIn > MaxExpiresIn {",
      "new": "\tif false && manager.tokenGenerator.ExpiresIn > MaxExpiresIn {",
      "tests": ["IDToken Manager rejects expires_in if larger then 24h"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 8)"]
    },
    {
      "id": "unknown-signing-algorithm-is-rejected",
      "source_file": "atc/creds/idtoken/manager.go",
      "old": "\tdefault:\n\t\treturn fmt.Errorf(\"invalid algorithm value: %s. Only %s and %s are supported\", manager.tokenGenerator.SubjectScope, jose.RS256, jose.ES256)",
      "new": "\tdefault:\n\t\treturn nil",
      "tests": ["IDToken Manager rejects unknown algorithm"],
      "scenarios": ["Production ID token manager behavior — <profile> (row 9)"]
    }
  ]
}
