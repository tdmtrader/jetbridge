{
  "name": "idtoken-generator-strict",
  "test_package": "./atc/creds/idtoken",
  "source_test_file": "atc/creds/idtoken/token_generator_test.go",
  "feature": "atc/worker/jetbridge/brine/features/idtoken-generator-strict.feature",
  "step_files": [
    "atc/worker/jetbridge/brine/steps/idtoken_generator_strict.go"
  ],
  "cases": [
    {
      "id": "default-pipeline-subject",
      "source_file": "atc/creds/idtoken/token_generator.go",
      "old": "\tcase SubjectScopePipeline:\n\t\treturn fmt.Sprintf(\"%s/%s\", team, pipeline)",
      "new": "\tcase SubjectScopePipeline:\n\t\treturn fmt.Sprintf(\"%s/%s-mutated\", team, pipeline)",
      "tests": [
        "IDToken TokenGenerator generates a valid token",
        "IDToken TokenGenerator Generated Token contains the correct subject"
      ],
      "scenarios": [
        "Strict ID token generator profile <profile> (row 1)",
        "Strict ID token generator profile <profile> (row 8)"
      ],
      "failure_contains": "strict ID token generator observation"
    },
    {
      "id": "team-subject-scope",
      "source_file": "atc/creds/idtoken/token_generator.go",
      "old": "\tcase SubjectScopeTeam:\n\t\treturn team",
      "new": "\tcase SubjectScopeTeam:\n\t\treturn team + \"-mutated\"",
      "tests": [
        "IDToken TokenGenerator respects subject scope team"
      ],
      "scenarios": [
        "Strict ID token generator profile <profile> (row 2)"
      ],
      "failure_contains": "strict ID token generator observation"
    },
    {
      "id": "instance-subject-scope",
      "source_file": "atc/creds/idtoken/token_generator.go",
      "old": "\tcase SubjectScopeInstance:\n\t\treturn fmt.Sprintf(\"%s/%s/%s\", team, pipeline, ivars)",
      "new": "\tcase SubjectScopeInstance:\n\t\treturn fmt.Sprintf(\"%s/%s/%s-mutated\", team, pipeline, ivars)",
      "tests": [
        "IDToken TokenGenerator respects subject scope instance"
      ],
      "scenarios": [
        "Strict ID token generator profile <profile> (row 3)"
      ],
      "failure_contains": "strict ID token generator observation"
    },
    {
      "id": "job-subject-scope",
      "source_file": "atc/creds/idtoken/token_generator.go",
      "old": "\tcase SubjectScopeJob:\n\t\treturn fmt.Sprintf(\"%s/%s/%s/%s\", team, pipeline, ivars, job)",
      "new": "\tcase SubjectScopeJob:\n\t\tif params.Job == \"testjob\" {\n\t\t\treturn fmt.Sprintf(\"%s/%s/%s/%s-mutated\", team, pipeline, ivars, job)\n\t\t}\n\t\treturn fmt.Sprintf(\"%s/%s/%s/%s\", team, pipeline, ivars, job)",
      "tests": [
        "IDToken TokenGenerator respects subject scope job"
      ],
      "scenarios": [
        "Strict ID token generator profile <profile> (row 4)"
      ],
      "failure_contains": "strict ID token generator observation"
    },
    {
