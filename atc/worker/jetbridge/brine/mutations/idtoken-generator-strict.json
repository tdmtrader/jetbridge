      "source_file": "atc/creds/idtoken/token_generator.go",
      "old": "\treturn strings.ReplaceAll(input, \"/\", \"%2F\")",
      "new": "\treturn input",
      "tests": [
        "IDToken TokenGenerator escapes sub parts safely"
      ],
      "scenarios": [
        "Strict ID token generator profile <profile> (row 5)"
      ],
      "failure_contains": "strict ID token generator observation"
