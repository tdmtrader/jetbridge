      "id": "clear-task-cache-targets-owning-job",
      "source_file": "atc/db/job.go",
      "old": "\t\tWhere(sq.Eq{\n\t\t\t\"job_id\":    j.id,\n\t\t\t\"step_name\": stepName,\n\t\t})",
      "new": "\t\tWhere(sq.Eq{\n\t\t\t\"job_id\":    -1,\n\t\t\t\"step_name\": stepName,\n\t\t})",
      "tests": [
        "Job Clear task cache when task cache exists when a path is provided deletes a row from the task_caches table",
        "Job Clear task cache when task cache exists when a path is provided removes the task cache",
        "Job Clear task cache when task cache exists when a path is not provided when an existing step-name is provided deletes a row from the task_caches table",
        "Job Clear task cache when task cache exists when a path is not provided when an existing step-name is provided removes the task cache"
      ],
      "scenarios": [
        "Job task-cache behavior — <profile> (row 1)",
        "Job task-cache behavior — <profile> (row 2)",
        "Job task-cache behavior — <profile> (row 3)",
        "Job task-cache behavior — <profile> (row 4)"
      ]
    }
