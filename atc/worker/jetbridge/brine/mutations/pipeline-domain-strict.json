      "source_file": "atc/db/pipeline.go",
      "old": "\treturn paused, nil\n}\nfunc (p *pipeline) Reload()",
      "new": "\treturn false, nil\n}\nfunc (p *pipeline) Reload()",
      "tests": ["Pipeline CheckPaused when the pipeline is paused returns the pipeline is paused"],
      "scenarios": ["Pipeline domain profile <profile> produces <result> (row 2)"],
      "failure_contains": "pipeline domain result"
    },
