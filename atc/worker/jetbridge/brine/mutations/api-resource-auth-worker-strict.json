      "new": "\tif acc.IsAdmin() {\n\t\th.rejector.Forbidden(w, r)\n\t\treturn\n\t}\n\tif acc.IsSystem() {\n\t\th.delegateHandler.ServeHTTP(w, r)\n\t\treturn\n\t}",
      "tests": [
        "CheckWorkerTeamAccessHandler when authenticated when worker exists and belongs to a team when user is admin/system calls worker delegate",
        "CheckWorkerTeamAccessHandler when authenticated when worker exists and belongs to a team when user is admin/system returns 200",
        "CheckWorkerTeamAccessHandler when authenticated when worker is not owned by a team when user is admin/system calls worker delegate",
        "CheckWorkerTeamAccessHandler when authenticated when worker is not owned by a team when user is admin/system returns 200"
