    {
      "id": "anonymous-worker-request-stops-before-downstream",
      "source_file": "atc/api/auth/check_worker_team_access_handler.go",
      "old": "\tif !acc.IsAuthenticated() {\n\t\th.rejector.Unauthorized(w, r)\n\t\treturn\n\t}",
      "new": "\tif !acc.IsAuthenticated() {\n\t\th.delegateHandler.ServeHTTP(w, r)\n\t\treturn\n\t}",
      "tests": [
        "CheckWorkerTeamAccessHandler when not authenticated returns 401",
        "CheckWorkerTeamAccessHandler when not authenticated does not call the scoped handler"
      ],
      "scenarios": [
        "Strict resource authorization profile <profile> preserves <source> (row 16)",
        "Strict resource authorization profile <profile> preserves <source> (row 17)"
      ],
      "failure_contains": "strict resource authorization result"
    },
    {
