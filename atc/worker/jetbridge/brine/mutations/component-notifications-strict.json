  "cases": [
    {
      "id": "resource-scope-changed-notifies",
      "source_file": "atc/db/resource.go",
      "old": "\tif changed {\n\t\tr.conn.Bus().Notify(atc.ComponentLidarScanner)\n\t}\n\n\treturn nil\n}",
      "new": "\tif changed {\n\t\tr.conn.Bus().Notify(atc.ComponentCollectorPipelines)\n\t}\n\n\treturn nil\n}",
      "tests": ["Component Notifications LidarScanner notifications Resource.SetResourceConfigScope notifies the scanner when scope changes"],
      "scenarios": ["Component notification profile <profile> produces <result> (row 1)"],
      "failure_contains": "component notification result"
    },
    {
      "id": "resource-scope-same-silent",
      "source_file": "atc/db/resource.go",
      "old": "\tif changed {\n\t\tr.conn.Bus().Notify(atc.ComponentLidarScanner)\n\t}\n\n\treturn nil\n}",
      "new": "\t_ = changed\n\tr.conn.Bus().Notify(atc.ComponentLidarScanner)\n\n\treturn nil\n}",
      "tests": ["Component Notifications LidarScanner notifications Resource.SetResourceConfigScope does not notify the scanner when scope is unchanged"],
      "scenarios": ["Component notification profile <profile> produces <result> (row 2)"],
      "failure_contains": "component notification result"
