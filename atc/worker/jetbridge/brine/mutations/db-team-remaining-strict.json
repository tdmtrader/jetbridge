{
  "name": "db-team-remaining-strict",
  "test_package": "./atc/db",
  "source_test_file": "atc/db/team_test.go",
  "feature": "atc/worker/jetbridge/brine/features/db-team-remaining-strict.feature",
  "step_files": [
    "atc/worker/jetbridge/brine/steps/db_team_remaining_strict.go",
    "atc/worker/jetbridge/brine/steps/registry.go",
    "atc/worker/jetbridge/brine/steps/assert.go",
    "atc/worker/jetbridge/brine/steps/resources.go",
    "atc/worker/jetbridge/brine/steps/task_command.go",
    "atc/worker/jetbridge/brine/steps/envtest.go",
    "atc/postgresrunner/postgresrunner.go",
    "atc/postgresrunner/ginkgo.go",
    "atc/postgresrunner/join_limit_conn.go"
  ],
  "cases": [
    {
      "id": "provider-auth-must-persist-owner",
      "source_file": "atc/db/team.go",
      "old": "\t\tSET auth = $1, legacy_auth = NULL, nonce = NULL",
      "new": "\t\tSET auth = $1::jsonb - 'owner', legacy_auth = NULL, nonce = NULL",
      "tests": [
        "Team Updating Auth UpdateProviderAuth saves auth team info to the existing team",
        "Team Updating Auth UpdateProviderAuth when team auth is already set overrides the existing auth with the new config"
      ],
      "scenarios": [
        "Remaining DB team source behavior — <profile> (row 4)",
        "Remaining DB team source behavior — <profile> (row 6)"
      ]
    },
    {
      "id": "provider-auth-must-clear-legacy",
      "source_file": "atc/db/team.go",
      "old": "\t\tSET auth = $1, legacy_auth = NULL, nonce = NULL",
      "new": "\t\tSET auth = $1, legacy_auth = legacy_auth, nonce = NULL",
      "tests": [
        "Team Updating Auth UpdateProviderAuth resets legacy_auth to NULL"
      ],
      "scenarios": [
        "Remaining DB team source behavior — <profile> (row 5)"
      ]
    },
    {
      "id": "one-off-build-starts-pending",
      "source_file": "atc/db/team.go",
      "old": "\t\t\"status\":  BuildStatusPending,",
      "new": "\t\t\"status\":  BuildStatusStarted,",
      "tests": [
        "Team CreateOneOffBuild can create one-off builds"
      ],
      "scenarios": [
        "Remaining DB team source behavior — <profile> (row 7)"
      ]
    },
    {
      "id": "started-build-has-started-status",
      "source_file": "atc/db/team.go",
      "old": "\t\t\"status\":       BuildStatusStarted,",
      "new": "\t\t\"status\":       BuildStatusPending,",
      "tests": [
        "Team CreateStartedBuild can create started builds with plans"
      ],
      "scenarios": [
        "Remaining DB team source behavior — <profile> (row 8)"
      ]
    },
    {
      "id": "started-build-persists-public-plan",
      "source_file": "atc/db/team.go",
      "old": "\t\t\"public_plan\":  plan.Public(),",
      "new": "\t\t\"public_plan\":  atc.Plan{},",
      "tests": [
        "Team CreateStartedBuild saves the public plan"
      ],
      "scenarios": [
        "Remaining DB team source behavior — <profile> (row 9)"
      ]
    },
    {
      "id": "started-build-emits-start-event",
      "source_file": "atc/db/team.go",
      "old": "\t\tStatus: atc.StatusStarted,",
      "new": "\t\tStatus: atc.StatusPending,",
      "tests": [
        "Team CreateStartedBuild creates Start event"
      ],
      "scenarios": [
        "Remaining DB team source behavior — <profile> (row 10)"
      ]
    },
    {
      "id": "save-pipeline-created-polarity",
      "source_file": "atc/db/team.go",
      "old": "\treturn pipelineID, !existingConfig, nil",
      "new": "\treturn pipelineID, existingConfig, nil",
      "tests": [
        "Team SavePipeline returns true for created",
        "Team SavePipeline it returns created as false when updated"
      ],
      "scenarios": [
        "Remaining DB team source behavior — <profile> (row 11)",
        "Remaining DB team source behavior — <profile> (row 16)"
      ]
    },
    {
      "id": "save-pipeline-honors-initial-pause",
      "source_file": "atc/db/team.go",
      "old": "\t\t\t\"paused\":          initiallyPaused,",
      "new": "\t\t\t\"paused\":          !initiallyPaused,",
      "tests": [
        "Team SavePipeline can be saved as paused",
        "Team SavePipeline can be saved as unpaused",
        "Team SavePipeline updating an existing pipeline maintains paused if the pipeline is paused",
        "Team SavePipeline updating an existing pipeline maintains unpaused if the pipeline is unpaused",
        "Team SavePipeline when there are multiple teams can allow pipelines with the same name across teams"
      ],
      "scenarios": [
        "Remaining DB team source behavior — <profile> (row 13)",
        "Remaining DB team source behavior — <profile> (row 14)",
        "Remaining DB team source behavior — <profile> (row 17)",
        "Remaining DB team source behavior — <profile> (row 18)",
        "Remaining DB team source behavior — <profile> (row 21)"
      ]
    }
  ]
