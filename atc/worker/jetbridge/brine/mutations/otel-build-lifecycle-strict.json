{
  "name": "otel-build-lifecycle-strict",
  "test_package": "./atc/metric",
  "source_test_file": "atc/metric/otel_build_lifecycle_test.go",
  "feature": "atc/worker/jetbridge/brine/features/otel-metrics.feature",
  "step_files": [
