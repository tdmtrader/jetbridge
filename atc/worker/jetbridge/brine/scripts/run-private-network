#!/bin/sh
# All suite resources share the private addresses used by real daemon peers.
set -eu
cd "$(dirname "$0")/.."

# This is brine's runner binary (see .brine's runner.binary): it is invoked
# before every local scenario run, so it is the right place to gate on the
# guard tests rather than trusting each caller to have run them separately.
# Its stdout IS the adapter's protocol stream (brine and the adapter's own
# tests parse it as JSON events) and its stderr is the adapter's diagnostic
# channel, which a clean `catalog` must leave empty. So a passing guard run
# says nothing at all; only a failing one is shown, on stderr.
if ! guard_output=$(go test ./steps/ -run 'Guard|Import|TempDir|Pending|Definition|NoStepLine|CitesARequirement' -count=1 2>&1); then
    printf '%s\n' "$guard_output" >&2
    echo "Guard tests failed; aborting before running scenarios" >&2
    exit 1
fi

brine_adapter=${BRINE_ADAPTER_BINARY:-$PWD/.build/brine-adapter-jetbridge}
brine_daemon=${BRINE_ARTIFACT_DAEMON_BINARY:-$PWD/.build/brine-artifact-daemon}
brine_launcher=$PWD/.build/brine-netns-exec
brine_busybox=${BRINE_BUSYBOX_BINARY:-$PWD/.build/busybox}
for brine_binary in "$brine_adapter" "$brine_daemon" "$brine_launcher" "$brine_busybox"; do
    case "$brine_binary" in
        /*) ;;
        *) echo "Private-network executable must have an absolute path: $brine_binary" >&2; exit 2 ;;
    esac
    if [ ! -x "$brine_binary" ]; then
        echo "Missing executable $brine_binary; run sh scripts/build-private-network first." >&2
        exit 2
    fi
done
export BRINE_ARTIFACT_DAEMON_BINARY="$brine_daemon"
export BRINE_BUSYBOX_BINARY="$brine_busybox"
# All addresses in this process are local to its namespace, never proxy targets.
export NO_PROXY='*'
export no_proxy='*'
exec "$brine_launcher" "$brine_adapter" "$@"
