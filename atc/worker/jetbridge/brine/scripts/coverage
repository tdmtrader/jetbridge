#!/bin/sh
# Run from any directory. Keep each run's raw data for inspection.
set -eu
cd "$(dirname "$0")/.."
# Resolve through any symlinks in the checkout path so this matches brine's
# own getcwd-resolved view of the repo, not just the shell's $PWD.
module_root=$(pwd -P)

# Guard tests are fast (no cluster, no build) and catch regressions that would
# otherwise waste the rest of this run's time. Abort before doing anything else.
if ! go test ./steps/ -run 'Guard|Import|TempDir|ActiveFeatureCorpus|Definition|NoStepLine' -count=1; then
    echo "Guard tests failed; aborting before build/run" >&2
    exit 1
fi

# Both tiers are required; never call a local-only result the full suite.
: "${BRINE_KUBE_CONTEXT:?Full coverage requires an explicitly authorized live Kubernetes context}"
# Validate live-fixture approval before spending time building or running the
# local tier. The fixtures still independently enforce these boundaries.
if [ "${BRINE_ALLOW_HOSTPATH_TESTS:-}" != 1 ] || [ "${BRINE_ALLOW_HOSTPORT_TESTS:-}" != 1 ]; then
    echo "Full coverage requires explicit BRINE_ALLOW_HOSTPATH_TESTS=1 and BRINE_ALLOW_HOSTPORT_TESTS=1 approval" >&2
    exit 1
fi
# The artifact node is approved by its label (brine.dev/live-artifacts=approved)
# or named in BRINE_LIVE_ARTIFACT_NODE; the fixture refuses if neither yields a
# Ready node, so there is nothing to check here.
: "${BRINE_LIVE_ARTIFACT_DAEMON_PORT:?Set the approved unused high TCP port}"
: "${BRINE_LIVE_ARTIFACT_DAEMON_BINARY:?Build and name the current static Linux artifact daemon}"
case "$BRINE_LIVE_ARTIFACT_DAEMON_BINARY" in
    /*) ;;
    *) echo "Artifact daemon binary path must be absolute" >&2; exit 1 ;;
esac
if [ ! -f "$BRINE_LIVE_ARTIFACT_DAEMON_BINARY" ] || [ ! -x "$BRINE_LIVE_ARTIFACT_DAEMON_BINARY" ]; then
    echo "Artifact daemon binary must be an existing executable" >&2
    exit 1
fi

# The peer tests need two real addresses at one daemon port. Prepare every
# executable before entering the isolated network; never build inside it.
sh scripts/build-private-network

production_package=github.com/concourse/concourse/atc/worker/jetbridge
minimum_percent=50
report_dir=$(mktemp -d "${TMPDIR:-/tmp}/brine-coverage.XXXXXX")
mkdir -p "$report_dir/raw/local" "$report_dir/raw/live" "$report_dir/raw/multinode" "$report_dir/merged"
printf 'Coverage evidence: %s\n' "$report_dir"

# Instrument main as well: Go installs its coverage exit hook there. Only the
# production package belongs in the reported denominator, not adapter code.
# Catch cancellation (INT/TERM/HUP) too, not just a normal EXIT: otherwise a
# killed run leaves the -cover adapter binary sitting in .build/. The signal
# trap only exits; `exit` runs the EXIT trap once, so the rebuild happens
# exactly once and the script never continues past a signal.
local_pid=
live_pid=
cleanup() {
    status=$?
    trap - 0
    # Repeated cancellation must not interrupt fixture drainage or leave the
    # instrumented adapter installed while the ordinary binary is rebuilt.
    trap '' INT TERM HUP
    # Each CLI and adapter share a process group. On interruption, let the
    # adapters drain fixtures, including detached groups, before restoration.
    for pid in $local_pid $live_pid; do /bin/kill -TERM -- "-$pid" 2>/dev/null || true; done
    if [ -n "$local_pid$live_pid" ]; then
        remaining=120
        while [ "$remaining" -gt 0 ]; do
            running=false
            for pid in $local_pid $live_pid; do
                if /bin/kill -0 -- "-$pid" 2>/dev/null; then running=true; fi
            done
            if [ "$running" = false ]; then break; fi
            sleep 1
            remaining=$((remaining - 1))
        done
        for pid in $local_pid $live_pid; do
            /bin/kill -KILL -- "-$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
        done
    fi
    if ! go build -o .build/brine-adapter-jetbridge ./cmd/brine-adapter-jetbridge; then status=1; fi
    exit "$status"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
go build -cover -covermode=atomic \
    -coverpkg="$production_package,$production_package/brine/cmd/brine-adapter-jetbridge" \
    -o .build/brine-adapter-jetbridge ./cmd/brine-adapter-jetbridge

# Build once, then execute complete manifests with the existing CLI gates.
# The local adapter has a private network namespace; the live adapter keeps
# the cluster route. Each process owns its databases, temporary roots and raw
# coverage directory. No feature, assertion, budget or production wait changes.
# Keep serial mode for matched baseline measurements and operational rollback.
schedule=${BRINE_COVERAGE_SCHEDULE:-parallel}
case "$schedule" in
    parallel|serial) ;;
    *) echo "BRINE_COVERAGE_SCHEDULE must be parallel or serial" >&2; exit 2 ;;
esac
command -v setsid >/dev/null
printf 'Brine coverage schedule: %s\n' "$schedule"
local_status=0
live_status=0
# Bypass the persistent engine so each adapter inherits its own GOCOVERDIR.
GOCOVERDIR="$report_dir/raw/local" setsid brine run local --no-engine --mode sync --format jsonl > "$report_dir/brine-local.log" 2>&1 &
local_pid=$!
if [ "$schedule" = serial ]; then
    wait "$local_pid" || local_status=$?
    local_pid=
fi
GOCOVERDIR="$report_dir/raw/live" setsid brine run live --no-engine --mode sync --format jsonl > "$report_dir/brine-live.log" 2>&1 &
live_pid=$!
# Always join both tiers. An ordinary test failure must not interrupt the
# other adapter's real scenarios or disposal. Any nonzero CLI verdict fails.
if [ -n "$local_pid" ]; then
    wait "$local_pid" || local_status=$?
    local_pid=
fi
wait "$live_pid" || live_status=$?
live_pid=
printf 'Brine CLI verdicts: local=%s live=%s\n' "$local_status" "$live_status"
cat "$report_dir/brine-local.log" "$report_dir/brine-live.log" > "$report_dir/brine.log"
if [ "$local_status" -ne 0 ] || [ "$live_status" -ne 0 ]; then
    # The log interleaves protocol events with every fixture's diagnostics,
    # so the last sixty lines are usually namespace chatter and say nothing
    # about WHICH scenario failed (CI build 873481). Lead with the verdict:
    # every scenario_end that is not a pass, the run_end, the failure count.
    echo "brine run failed. Scenarios that did not pass:" >&2
    grep '"type":"scenario_end"' "$report_dir/brine.log" | grep -v '"status":"passed"' >&2 || true
    # One log holds every discovered manifest, so a bare count mixes the
    # tiers: count per manifest (CI build 1126315 read "550 passed" as the
    # local tier's progress; 131 of them were the live tier's).
    grep '"type":"scenario_end"' "$report_dir/brine.log" |
        sed -n 's/.*"manifest":"\([^"]*\)".*/\1/p' | sort | uniq -c |
        while read -r n manifest; do
            printf 'scenario_end records for %s: %s total, %s passed\n' "$manifest" "$n" \
                "$(grep '"type":"scenario_end"' "$report_dir/brine.log" | grep -F "\"manifest\":\"$manifest\"" | grep -c '"status":"passed"' || true)" >&2
        done
    grep '"type":"run_end"' "$report_dir/brine.log" >&2 || true
    # A run_end can count a failure no scenario_end carries: the adapter
    # exits non-zero when a disposal fails or a temp root leaks, and says
    # which on stderr, interleaved with everything else. Name it here.
    echo "Adapter exit failures:" >&2
    grep -E '^brine-adapter-jetbridge: (disposal failed|temp leak|panic):' "$report_dir/brine.log" >&2 || echo "(none)" >&2
    # A panic in a step body ends the adapter without a scenario_end, so
    # nothing above names the scenario. The trace follows the panic line
    # and the scenario that was running is the last scenario_start before
    # it (CI build 1126315: 550 passes, no run_end, trace never printed).
    grep -n -E '^brine-adapter-jetbridge: panic:' "$report_dir/brine.log" | cut -d: -f1 | head -5 |
    while read -r line; do
        echo "--- scenario running at the panic on line $line:" >&2
        sed -n "1,${line}p" "$report_dir/brine.log" | grep '"type":"scenario_start"' | tail -1 >&2 || true
        echo "--- trace after line $line:" >&2
        sed -n "${line},$((line + 60))p" "$report_dir/brine.log" | grep -v '^{' >&2 || true
    done
    # The fixtures' own diagnostics (what a step cancelled, which lock it
    # released) are the lines just before each failing scenario_end; the
    # tail alone never reaches them. Print the forty non-protocol lines
    # before each failure, at most the first twenty failures.
    grep -n '"type":"scenario_end"' "$report_dir/brine.log" | grep -v '"status":"passed"' | cut -d: -f1 | head -20 |
    while read -r line; do
        from=$((line - 40)); [ "$from" -ge 1 ] || from=1
        echo "--- diagnostics before failing record at line $line:" >&2
        sed -n "${from},${line}p" "$report_dir/brine.log" | grep -v '^{' >&2 || true
    done
    echo "Last lines of $report_dir/brine.log:" >&2
    tail -60 "$report_dir/brine.log" >&2
    exit 1
fi
# Each tier log must independently contain its complete manifest and a
# successful run_end. Combining logs before verifying could let one run_end
# hide an incomplete sibling. Manifest paths remain the CLI's absolute paths.
#
# NAME=PATH, not a bare NAME: brine-verify-run rejects a manifest with no
# declared floor, because "at least one scenario passed" certified a run of 3
# out of 568. Here the name and the path are the same string -- the name
# because that is what `scenario_end.manifest` carries, the path so the floor
# is COUNTED OUT OF each manifest's own feature files rather than restated as
# a number in this script that would rot the next time a feature is added.
go run ./cmd/brine-verify-run "$report_dir/brine-local.log" \
    "$module_root/local/.brine=$module_root/local/.brine"
go run ./cmd/brine-verify-run "$report_dir/brine-live.log" \
    "$module_root/live/.brine=$module_root/live/.brine"

# The cross-node tier (live-multinode/.brine, discover: false) needs two
# approved artifact nodes up -- one of them may be a desktop that sleeps -- so
# count them the way the fixture does and say which way it went: a tier that
# did not run must never read as one that passed.
if [ "${BRINE_KUBE_CONTEXT:-}" = in-cluster ]; then context_flag=""; else context_flag="--context=${BRINE_KUBE_CONTEXT:-}"; fi
if [ -n "${BRINE_LIVE_ARTIFACT_NODE:-}" ]; then
    approved_up=1
else
    approved_up=$(kubectl $context_flag get nodes -l brine.dev/live-artifacts=approved \
        -o jsonpath='{range .items[*]}{.spec.unschedulable}|{.status.conditions[?(@.type=="Ready")].status}|{.metadata.labels.concourse\.dev/artifact-cache}{"\n"}{end}' |
        grep -c '^|True|ready$' || true)
fi
coverage_inputs="$report_dir/raw/local,$report_dir/raw/live"
if [ "$approved_up" -ge 2 ]; then
    echo "cross-node tier: $approved_up approved artifact nodes up; running live-multinode/.brine" >&2
    if ! (cd live-multinode && GOCOVERDIR="$report_dir/raw/multinode" brine run --no-engine --mode sync --format jsonl) > "$report_dir/brine-multinode.log" 2>&1; then
        echo "cross-node tier failed. Scenarios that did not pass:" >&2
        grep '"type":"scenario_end"' "$report_dir/brine-multinode.log" | grep -v '"status":"passed"' >&2 || true
        tail -80 "$report_dir/brine-multinode.log" >&2
        exit 1
    fi
    go run ./cmd/brine-verify-run "$report_dir/brine-multinode.log" \
        "$module_root/live-multinode/.brine=$module_root/live-multinode/.brine"
    coverage_inputs="$coverage_inputs,$report_dir/raw/multinode"
else
    echo "cross-node tier NOT run: $approved_up approved artifact node(s) up, it needs 2" >&2
fi
go tool covdata merge -i="$coverage_inputs" -o="$report_dir/merged"
go tool covdata textfmt -i="$report_dir/merged" -pkg="$production_package" \
    -o="$report_dir/coverage.out"
go tool covdata percent -i="$report_dir/merged" -pkg="$production_package"

# Empty scans and rounded percentages must never satisfy the gate.
awk -v package="$production_package/" -v minimum="$minimum_percent" '
    NR == 1 { next }
    index($1, package) != 1 { unexpected = 1 }
    { total += $2; if ($3 > 0) covered += $2 }
    END {
        if (unexpected || total == 0) {
            print "FAIL: missing or unexpected production coverage data"
            exit 2
        }
        printf "Brine covers %d/%d production statements (%.6f%%); target >= %g%%\n", \
            covered, total, 100 * covered / total, minimum
        if (100 * covered < minimum * total) exit 1
    }
' "$report_dir/coverage.out"
