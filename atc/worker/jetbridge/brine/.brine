# JetBridge behavioral contract, run through brine.
#
# A `runner:` block, NOT `language: go`. `language:` is sugar for the OFFICIAL
# runner — for go that resolves to brine's own brine-adapter-go, whose registry
# is the conformance vocabulary, and which accept-and-ignores the `--binary`
# flag that `config.binary` becomes. A consuming repo hosting its own registry
# is a third-party runner by brine's own definition
# (docs/RUNNER-AUTHORS.md §3), and names itself here.
runner:
  name: jetbridge
  binary: scripts/run-private-network
  contract: 5

# Document-native conformance. The Go registry's authoring model remains 3;
# it is independent of this conformance pin.
contract: 5

features: "features/*.feature"
budgets:
  undefined: 0
