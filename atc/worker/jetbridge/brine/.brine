# JetBridge behavioral contract, run through brine.
#
# A `runner:` block, NOT `language: go`. `language:` is sugar for the OFFICIAL
# runner — for go that resolves to brine's own brine-adapter-go, whose registry
# is the conformance vocabulary, and which accept-and-ignores the `--binary`
# flag that `config.binary` becomes. A consuming repo hosting its own registry
# is a third-party runner by brine's own definition
# (docs/RUNNER-AUTHORS.md §3), and names itself here.
runner:
  name: jetbridge
  binary: .build/brine-adapter-jetbridge
  contract: 5

# 3 -> 5, and THE FROZEN-VERSION PREFERENCE HAD TO YIELD (2026-09-09). The
# original pin was deliberate: 3 is byte-frozen forever, and a first consumer
# wants the version that cannot move underneath it, at the price of one
# advisory CONTRACT_LAG finding.
#
# Contract 5 removes that choice rather than making it less attractive.
# Contracts 3 and 4 are the FLAGS ERA — an adapter conforming to either reads
# `--features`, `--tags`, `--exclude-tags`, `--line` and `--resources` — and
# brine-dispatch stopped emitting all five UNCONDITIONALLY at the v5 mint
# (dispatch/src/lib.rs: "ALWAYS, since contract 5"; no contract-3 branch
# survives). So a `contract: 3` claim from this adapter is now simply false:
# the binary beside it is document-native and cannot honour the era it names.
# 5 is current-but-growing, which is the cost we now carry instead.
contract: 5

features: "features/*.feature"
budgets:
  undefined: 0
