# JetBridge behavioral contract, run through brine.
#
# A `runner:` block, NOT `language: go`. `language:` is sugar for the OFFICIAL
# runner — for go that resolves to brine's own brine-adapter-go, whose registry
# is the conformance vocabulary, and which accept-and-ignores the `--binary`
# flag that `config.binary` becomes. A consuming repo hosting its own registry
# is a third-party runner by brine's own definition
# (docs/RUNNER-AUTHORS.md §3), and names itself here.
#
# The binary is a wrapper, not the adapter itself: scripts/run-private-network
# builds .build/brine-adapter-jetbridge and runs it inside an unprivileged
# user+network namespace so the local tier owns its own loopback and ports.
# The live tier (live/.brine) runs the same adapter against a real cluster.
runner:
  name: jetbridge
  binary: scripts/run-private-network
  contract: 5

# Document-native conformance (contract 5, since 2026-09-09). Contracts 3 and 4
# were the flags era; brine-dispatch no longer emits those flags, so the
# adapter is document-native and this pin must say so. The Go registry's
# authoring model remains 3; it is independent of this conformance pin.
contract: 5

features: "features/*.feature"
budgets:
  undefined: 0
  # De-enrolment guard: the run must resolve to at least this many scenarios
  # (outline rows expanded). Counted out of features/*.feature on 2026-09-19;
  # raise it with every batch that adds scenarios, never lower it without a
  # disposition row in DISPOSITION-jetbridge.md for each scenario that left.
  scenarios_min: 550
