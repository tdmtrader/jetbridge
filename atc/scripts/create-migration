#!/bin/bash

set -e -u

cd "$(dirname "$0")/.."

# Generate an editable up and a forward-only down with this checkout's generator.
migration_cli="$(go env GOPATH)/bin/migrate"
go build -tags 'postgres' -o "$migration_cli" ./db/migration/cli

"$migration_cli" generate -d ./db/migration/migrations/ -n"$1" -t "${2-sql}"
