.DS_Store
.idea
.vscode
*.iml
node_modules
.yarn
*-packr.go
tags
# Frontend build outputs - committed to git so the Go binary embeds them
# via //go:embed without requiring Node.js at build time.
# Rebuild with: yarn install && yarn run build
# web/public/elm.js        # unminified, not committed (1.3MB)
web/public/main.out.css
docker-compose.override.yml
*.coverprofile
*.coverprofile.*
*.test

ci/deployments/*/.terraform/
ci/deployments/*/keys/gcp.json
ci/deployments/*/keys/id_rsa
ci/deployments/*/keys/id_rsa.pub

hack/vault/init.json
worker/runtime/integration/sample/sample

# Compiled binaries
/concourse
/concourse-linux-arm64
/concourse-linux-amd64
/fly-linux-amd64
/artifact-daemon
cmd/artifact-daemon/artifact-daemon
/artifact-daemon-linux-amd64
/artifact-daemon-linux-arm64

# Editor / AI tool configs
.claude/worktrees/
.codex/
.cursor/
.gemini/
.mcp.json

# Build artifacts
/fly-assets/

# Forge orchestrator logs
forge/.orchestrator/
package-lock.json

# Local scratch: git worktrees and throwaway clusters live in the tree.
.worktrees/
.local-cluster/
.claude/

# Build intermediate: `elm make` emits elm.js, uglifyjs minifies it to
# elm.min.js, and index.html loads only the minified file. Committing it
# put 1.4 MB of generated code into every binary via //go:embed.
web/public/elm.js
