# Build intermediates and caches. web/public/elm.js is gitignored and rebuilt
# by Dockerfile.build's frontend stage; the brine adapter build and compiled
# Go test binaries are local artefacts of the test tiers.
web/public/elm.js
atc/worker/jetbridge/brine/.build
**/*.test
**/__pycache__
**/*.pyc

# Test data read at test run time only; no image builds or runs these tests.
