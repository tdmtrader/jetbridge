FROM ubuntu:22.04

RUN apt-get update && \
    apt-get install -y ca-certificates dumb-init && \
    rm -rf /var/lib/apt/lists/*

COPY concourse-linux-arm64 /usr/local/concourse/bin/concourse
COPY artifact-daemon-linux-arm64 /usr/local/concourse/bin/artifact-daemon
# The Hangar disk owner. It is here for the same reason the daemon is: the
# chart runs it by absolute path out of this image, and an image missing it is
# a Pod that CrashLoopBackOffs with "no such file or directory" rather than a
# render that fails. deploy/chart/tests/image_parity_test.go is what keeps the
# two files in step with the chart. The output plane's publisher is the
# artifact daemon, and its reclaim and orphan sweep run in web.
COPY hangar-store-linux-arm64 /usr/local/concourse/bin/hangar-store
COPY fly-assets /usr/local/concourse/fly-assets
RUN chmod +x /usr/local/concourse/bin/*

ENV PATH="/usr/local/concourse/bin:${PATH}"

ENTRYPOINT ["dumb-init", "concourse"]
